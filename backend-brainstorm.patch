 spring.application.name=ifsc
+
+# PostgreSQL (sobrescreva com as variáveis de ambiente DB_URL, DB_USER, DB_PASSWORD)
+spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/brainstorm}
+spring.datasource.username=${DB_USER:postgres}
+spring.datasource.password=${DB_PASSWORD:postgres}
+
+# cria/atualiza as tabelas automaticamente (ok para desenvolvimento)
+spring.jpa.hibernate.ddl-auto=update
+spring.jpa.open-in-view=false
