+# Conexão com o Supabase (PostgreSQL).
+# Este arquivo (classpath:/config/) tem prioridade sobre o application.properties da raiz.
+# A senha NÃO fica aqui: defina a variável de ambiente DB_PASSWORD antes de subir a app.
+
+# Conexão direta (só funciona com IPv6 na sua rede):
+spring.datasource.url=${DB_URL:jdbc:postgresql://db.cacdmvuqbauzsjrhuqpk.supabase.co:5432/postgres?sslmode=require}
+spring.datasource.username=${DB_USER:postgres}
+spring.datasource.password=${DB_PASSWORD}
+
+# Se a conexão direta falhar (rede só IPv4), use o "Session pooler" (Connect > Session pooler no painel):
+#   DB_URL=jdbc:postgresql://aws-<N>-<REGIAO>.pooler.supabase.com:5432/postgres?sslmode=require
+#   DB_USER=postgres.cacdmvuqbauzsjrhuqpk
+
+spring.jpa.hibernate.ddl-auto=update
+spring.jpa.open-in-view=false
diff --git a/supabase-seguranca.sql b/supabase-seguranca.sql
new file mode 100644
index 0000000..37d94a9
--- /dev/null
+++ b/supabase-seguranca.sql
@@ -0,0 +1,14 @@
+-- Rode UMA vez no SQL Editor do Supabase, depois da primeira execução da app
+-- (as tabelas só existem depois que o Spring as cria).
+--
+-- O Supabase expõe o schema "public" pela Data API (REST). Tabelas criadas por SQL/JDBC
+-- nascem SEM Row Level Security, então "usuarios" (hash de senha + token) poderia ser lida
+-- por quem tiver a anon key. Com RLS ligado e sem policies, a Data API não enxerga nada.
+-- A app Spring conecta como "postgres" (dono das tabelas), que ignora RLS: nada muda pra ela.
+
+ALTER TABLE public.usuarios ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.cotacoes ENABLE ROW LEVEL SECURITY;
+
+-- conferir (rowsecurity deve ser true nas duas):
+SELECT tablename, rowsecurity FROM pg_tables
+WHERE schemaname = 'public' AND tablename IN ('usuarios', 'cotacoes');
